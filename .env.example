# Reference only; Python does not automatically load this file.
DS02_TRACKER_HOST=127.0.0.1
DS02_TRACKER_PORT=9000
DS02_LEASE_SECONDS=30
DS02_IO_TIMEOUT=5
# Supply a JSON object with a different secret (16..256 characters) per peer.
# No real keys should be committed.
DS02_PEER_KEYS={}

# Peer process settings. Use the token issued for this peer ID.
DS02_PEER_ID=peer1
DS02_PEER_TOKEN=
# Use the same swarm key on all peers in this demo.
DS02_SWARM_KEY=
DS02_PEER_HOST=127.0.0.1
DS02_PEER_PORT=9101
DS02_STORAGE=data/peer1
DS02_ACTION=serve
DS02_FILE=
DS02_FILE_ID=
DS02_CHUNK_SIZE=65536
DS02_DOWNLOAD_WORKERS=4
DS02_CHUNK_RETRIES=5

# Fault simulation for the demo.
DS02_UPLOAD_DELAY=0
DS02_CORRUPT_INDEX=-1
